---
import Reveal from '../motion/Reveal.astro';
import { site } from '../site';

const { title, body } = site.openSource;
---

<Reveal as="section">
  <div class="open-source">
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
</Reveal>

<style>
  .open-source {
    max-width: var(--read);
    margin-top: clamp(120px, 18vw, 200px);
  }

  h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    line-height: 1.25;
    margin-bottom: 12px;
  }

  p {
    color: var(--pencil);
    font-size: 1.0625rem;
  }
</style>
