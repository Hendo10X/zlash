---
/*
  Fades its content in once, the first time it scrolls into view.
  `delay` staggers siblings in a staged entrance (multiples of 100ms).
*/
interface Props {
  delay?: 0 | 100 | 200 | 300 | 400;
  as?: 'div' | 'li' | 'section';
}

const { delay = 0, as: Tag = 'div' } = Astro.props;
---

<Tag class="reveal" style={`--reveal-delay: ${delay}ms`} data-reveal>
  <slot />
</Tag>

<style>
  @media (scripting: enabled) {
    .reveal {
      opacity: 0;
      transition: opacity var(--enter) var(--ease-out) var(--reveal-delay);
    }

    @media (prefers-reduced-motion: no-preference) {
      .reveal {
        filter: blur(4px);
        translate: 0 12px;
        transition-property: opacity, filter, translate;
        transition-duration: var(--enter);
        transition-timing-function: var(--ease-out);
        transition-delay: var(--reveal-delay);
      }
    }

    .reveal.is-visible {
      opacity: 1;
      filter: none;
      translate: 0 0;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );

  for (const el of document.querySelectorAll('[data-reveal]')) observer.observe(el);
</script>
