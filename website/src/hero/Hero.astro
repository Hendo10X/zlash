---
import DownloadLink from '../download/DownloadLink.astro';
import Reveal from '../motion/Reveal.astro';
import { site } from '../site';
import Wordmark from './wordmark/Wordmark.astro';
---

<section class="hero">
  <Wordmark text={site.name} />

  <div class="intro">
    <Reveal delay={200}>
      <p class="tagline">{site.tagline}</p>
    </Reveal>
    <Reveal delay={300}>
      <p class="summary">{site.summary}</p>
    </Reveal>
    <Reveal delay={400}>
      <div class="actions">
        <DownloadLink look="button" />
        {site.sourceHref && <a class="source" href={site.sourceHref}>View source</a>}
      </div>
    </Reveal>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(120px, 18vh, 200px);
  }

  .intro {
    display: grid;
    gap: 16px;
    max-width: var(--read);
    margin-top: clamp(40px, 7vw, 72px);
  }

  .tagline {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .summary {
    color: var(--pencil);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin-top: 16px;
  }

  .source {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--pencil);
  }

  @media (hover: hover) {
    .source:hover { color: var(--paper); }
  }
</style>
